        if info.type.consumeMData.isProp then
          out := out.push n
    t := t.bindingBody!.consumeMData
  return out

/-- (3): the rows used directly by a proof term. -/
def rowsUsed (value : Expr) : NameSet := Id.run do
  let mut out : NameSet := {}
