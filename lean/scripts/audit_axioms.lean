    | .opaqueInfo _ => "opaque"
    | .thmInfo _ => "theorem"
    | _ => "other"
  logInfo m!"RBREG|{name.toString}|{kind}|{toString info.type.consumeMData.isProp}|END"
end RobinsonAudit

